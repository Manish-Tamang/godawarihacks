# ── Sanity ────────────────────────────────────────────────
# Required: the app throws on startup without the project id and dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only. Needed for registration intake and the migration scripts.
SANITY_WRITE_TOKEN=
# Must match the secret set on the registration-status webhook in sanity.io/manage.
SANITY_WEBHOOK_SECRET=

# ── Supabase (admin auth) ─────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL is the project URL (https://<ref>.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY is a JWT. Do not swap these — next.config.mjs
# swallows the resulting error and every Supabase call fails silently.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Captcha ───────────────────────────────────────────────
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ── Mail ──────────────────────────────────────────────────
SMTP_USER=
SMTP_PASSWORD=

# ── Misc ──────────────────────────────────────────────────
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_PROJECTID=
