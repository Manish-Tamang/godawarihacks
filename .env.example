# ── Sanity ────────────────────────────────────────────────
# Required at BUILD time — it is inlined into the client bundle, so it has to
# be set wherever `next build` runs (Vercel: Project Settings -> Environment
# Variables, for every environment you deploy). The build fails without it.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Optional; defaults to "production".
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only, read at request time. Needed for registration intake and the
# migration scripts; /api/register returns a 500 without it.
SANITY_WRITE_TOKEN=
# Must match the secret set on the registration-status webhook in sanity.io/manage.
SANITY_WEBHOOK_SECRET=

# ── Captcha ───────────────────────────────────────────────
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ── Mail ──────────────────────────────────────────────────
SMTP_USER=
SMTP_PASSWORD=

# ── Misc ──────────────────────────────────────────────────
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_PROJECTID=
